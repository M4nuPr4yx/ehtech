{
  "openapi": "3.0.3",
  "info": {
    "title": "EHtech — Marketplace e moderação",
    "version": "1.0.0",
    "description": "Consultas públicas: não exigem cadastro, login ou token. GET /produtos retorna a vitrine inteira e é o cenário de maior volume de resposta. GET /produtos/catalogo representa a navegação paginada e executa COUNT + SELECT. POST /produtos exige autenticação JWT (obtenha o token em POST /login) e cria um produto com status 'pendente'. A rota mais lenta só pode ser determinada por medição. As fotos são referências/dados no JSON: Swagger e testes HTTP desta API não baixam automaticamente as imagens referenciadas."
  },
  "servers": [
    {
      "url": "..",
      "description": "Servidor Relativo — funciona automaticamente via localhost ou pelo IP na rede local"
    }
  ],
  "tags": [
    {
      "name": "Autenticação",
      "description": "Login e obtenção de token JWT. Necessário para rotas protegidas."
    },
    {
      "name": "Produtos",
      "description": "Leitura pública (sem token) e cadastro de anúncios (requer JWT)."
    }
  ],
  "security": [],
  "paths": {
    "/login": {
      "post": {
        "tags": ["Autenticação"],
        "operationId": "login",
        "summary": "Autenticar usuário e obter token JWT",
        "description": "Valida e-mail (até 254 caracteres) e senha (até 1024 bytes UTF-8) e retorna JWT Bearer por 8 horas. Aceita hashes bcrypt anteriores e scrypt novos. Resposta sem cache. Os logins comum e administrativo compartilham contadores persistentes entre instâncias: 10 falhas por conta/rede e 100 por rede em janela fixa de 15 minutos. Tentativas concorrentes reservam vaga; sucesso devolve apenas a própria reserva. Também mantém o limite em memória por IP. Copie token e use Authorize para rotas protegidas.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CredenciaisLogin"
              },
              "example": {
                "email": "usuario@gmail.com",
                "senha": "minhasenha123"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login realizado. Use o campo `token` no botão Authorize.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespostaLogin"
                },
                "example": {
                  "mensagem": "Login OK",
                  "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
                  "username": "meuusuario",
                  "email": "usuario@gmail.com",
                  "userId": 42,
                  "foto": null
                }
              }
            }
          },
          "400": {
            "description": "E-mail ou senha ausentes.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Erro" },
                "example": { "mensagem": "E-mail e senha são obrigatórios" }
              }
            }
          },
          "401": {
            "description": "Credenciais inválidas.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Erro" },
                "example": { "mensagem": "E-mail ou senha incorretos" }
              }
            }
          },
          "429": {
            "description": "Limite em memória de 20 requisições/IP em 15 minutos ou limite persistente de tentativas de senha. Retorna Retry-After.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Erro" },
                "example": { "mensagem": "Muitas tentativas de autenticação. Tente novamente em 15 minutos." }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Segundos até nova tentativa.",
                "schema": { "type": "integer" }
              }
            }
          },
          "503": {
            "description": "Autenticação temporariamente indisponível; falha fechada se não for possível verificar os limites no banco.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Erro" },
                "example": { "mensagem": "Não foi possível entrar agora. Tente novamente em instantes." }
              }
            }
          }
        }
      }
    },
    "/produtos": {
      "get": {
        "tags": ["Produtos"],
        "operationId": "listarProdutos",
        "summary": "Vitrine completa — cenário de maior volume",
        "description": "Todos os produtos aprovados, ordenados por id decrescente. Não há paginação nem filtros nesta rota legada. Origem pública contém somente cidade/UF; origem_snapshot e origem_endereco_id são removidos. O corpo cresce com a quantidade de anúncios e o tamanho do campo imagem.",
        "responses": {
          "200": {
            "description": "Lista completa; [] se não houver anúncios aprovados.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/ProdutoCompleto" }
                },
                "example": [
                  {
                    "id_produto": 1,
                    "nome": "Notebook de exemplo",
                    "descricao": "Produto ilustrativo.",
                    "preco": "2499.90",
                    "estoque": 5,
                    "categoria": "notebooks",
                    "imagem": null,
                    "vendedor": "Vendedor exemplo",
                    "vendedor_id": 2,
                    "status_aprovacao": "aprovado",
                    "data_criacao": "2026-09-10T10:00:00.000Z"
                  }
                ]
              }
            }
          },
          "429": {
            "description": "Limite padrão: 300 requisições por IP em 15 minutos.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Erro" },
                "example": { "mensagem": "Muitas requisições. Tente novamente em alguns minutos." }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Segundos até nova tentativa.",
                "schema": { "type": "integer" }
              }
            }
          },
          "500": {
            "description": "Falha ao consultar o banco.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Erro" },
                "example": { "mensagem": "Erro ao listar produtos" }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Produtos"],
        "operationId": "cadastrarProduto",
        "summary": "Cadastrar produto — requer autenticação JWT",
        "description": "Cria anúncio pendente para aprovação. Produtos físicos (exige_entrega omitido ou true) exigem origem_endereco_id e origem_versao de endereço salvo, próprio e confirmado. Copia a origem para o anúncio; editar/excluir a agenda não altera essa cópia. Somente cidade/UF são públicos. exige_entrega=false dispensa origem apenas para itens sem envio físico. Requer JWT e mantém rate limit padrão de 300 req/IP em 15 min.",
        "security": [
          { "bearerAuth": [] }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/NovoProduto" },
              "example": {
                "nome": "Teclado Mecânico RGB",
                "descricao": "Teclado compacto 75% com switches blue e retroiluminação RGB.",
                "preco": 349.90,
                "estoque": 10,
                "categoria": "perifericos",
                "imagem": null,
                "origem_endereco_id": 1,
                "origem_versao": 1
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Produto cadastrado com sucesso e aguardando aprovação.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "mensagem": { "type": "string" },
                    "id": { "type": "integer", "description": "ID do produto criado." }
                  }
                },
                "example": {
                  "mensagem": "Produto cadastrado com sucesso! Aguardando aprovação.",
                  "id": 123
                }
              }
            }
          },
          "404": { "description": "Origem não encontrada entre os endereços salvos da conta.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Erro" } } } },
          "409": { "description": "Origem alterada ou ainda não confirmada.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Erro" } } } },
          "400": {
            "description": "Dados do produto inválidos ou ausentes, incluindo origem obrigatória para produto físico.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Erro" },
                "examples": {
                  "nome_ausente": {
                    "summary": "Nome ausente",
                    "value": { "mensagem": "Nome do produto é obrigatório" }
                  },
                  "preco_invalido": {
                    "summary": "Preço inválido",
                    "value": { "mensagem": "Preço deve ser um valor numérico positivo" }
                  },
                  "categoria_ausente": {
                    "summary": "Categoria ausente",
                    "value": { "mensagem": "Categoria é obrigatória" }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Token ausente ou no formato errado.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Erro" },
                "example": { "error": "Token não fornecido" }
              }
            }
          },
          "403": {
            "description": "Token inválido ou expirado.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Erro" },
                "examples": {
                  "token_expirado": {
                    "summary": "Token expirado",
                    "value": { "error": "Token expirado. Faça login novamente.", "code": "TOKEN_EXPIRED" }
                  },
                  "token_invalido": {
                    "summary": "Token inválido",
                    "value": { "error": "Token inválido. Faça login novamente.", "code": "INVALID_TOKEN" }
                  }
                }
              }
            }
          },
          "429": {
            "description": "Limite padrão de 300 req/IP em 15 min atingido. Não é ampliável para esta rota.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Erro" },
                "example": { "mensagem": "Muitas requisições. Tente novamente em alguns minutos." }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Segundos até nova tentativa.",
                "schema": { "type": "integer" }
              }
            }
          },
          "500": {
            "description": "Falha ao inserir no banco.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Erro" },
                "example": { "mensagem": "Erro ao cadastrar produto" }
              }
            }
          }
        }
      }
    },
    "/produtos/catalogo": {
      "get": {
        "tags": ["Produtos"],
        "operationId": "consultarCatalogo",
        "summary": "Catálogo paginado — cenário de uso habitual",
        "description": "Produtos aprovados com estoque primeiro. Busca literal sem distinguir maiúsculas em nome/descrição. Filtra cidade exata/UF de origem e datas inclusivas de publicação; campos privados de origem nunca são retornados. Relevância: nome exato, prefixo, trecho do nome, descrição, desempatando por data/ID. Sem busca, relevância usa recentes. Datas desconhecidas de anúncios antigos ficam por último e não entram no filtro por data. Categoria ignora capitalização; audio aceita áudio/fones de ouvido. Catálogo anônimo reutilizável no CDN Vercel por 15 segundos e revalidação em segundo plano por mais 30 segundos. Navegador revalida; Authorization ou Cookie recebem no-store. Aprovação e regras de compra são conferidas no servidor.",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Página: inválidos ou <= 0 viram 1; acima de 100000 são limitados.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000,
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Itens: inválidos ou <= 0 viram 12; acima de 24 são limitados.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 24,
              "default": 12
            }
          },
          {
            "name": "search",
            "in": "query",
            "description": "Trecho do nome; espaços externos removidos; truncado em 100 caracteres.",
            "schema": { "type": "string", "maxLength": 100 },
            "example": "Notebook"
          },
          {
            "name": "categoria",
            "in": "query",
            "description": "Categoria exata sem diferenciar maiúsculas/minúsculas; truncada em 60 caracteres.",
            "schema": { "type": "string", "maxLength": 60 },
            "example": "notebooks"
          },
          {
            "name": "precoMin",
            "in": "query",
            "description": "Mínimo inclusivo em reais. Inválidos ou negativos são ignorados.",
            "schema": { "type": "number", "minimum": 0 },
            "example": 100
          },
          {
            "name": "precoMax",
            "in": "query",
            "description": "Máximo inclusivo em reais. Inválidos ou negativos são ignorados; menor que precoMin retorna 400.",
            "schema": { "type": "number", "minimum": 0 },
            "example": 5000
          },
          {
            "name": "ordenacao",
            "in": "query",
            "description": "Ausente ou desconhecida usa recentes. Empates usam id decrescente.",
            "schema": {
              "type": "string",
              "enum": ["recentes", "antigos", "relevancia", "menor-preco", "maior-preco"],
              "default": "recentes"
            }
          },
          { "name": "uf", "in": "query", "description": "UF de origem do envio; inválida retorna 400.", "schema": { "type": "string", "minLength": 2, "maxLength": 2 } },
          { "name": "cidade", "in": "query", "description": "Cidade exata de origem, sem distinguir maiúsculas.", "schema": { "type": "string", "maxLength": 100 } },
          { "name": "dataInicio", "in": "query", "description": "Data inicial inclusiva da publicação.", "schema": { "type": "string", "format": "date" } },
          { "name": "dataFim", "in": "query", "description": "Data final inclusiva. Datas inexistentes ou intervalo invertido retornam 400.", "schema": { "type": "string", "format": "date" } }
        ],
        "responses": {
          "200": {
            "description": "totalPages é pelo menos 1 mesmo sem produtos. Página além dos resultados retorna items vazio.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Catalogo" },
                "example": {
                  "items": [
                    {
                      "id_produto": 1,
                      "nome": "Notebook de exemplo",
                      "descricao": "Produto ilustrativo.",
                      "preco": "2499.90",
                      "estoque": 5,
                      "categoria": "notebooks",
                      "imagem": null
                    }
                  ],
                  "total": 1,
                  "page": 1,
                  "limit": 12,
                  "totalPages": 1
                }
              }
            }
          },
          "400": {
            "description": "Intervalo de preços invertido.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Erro" },
                "example": { "mensagem": "O preço mínimo não pode ser maior que o máximo" }
              }
            }
          },
          "429": {
            "description": "Limite padrão: 300 requisições por IP em 15 minutos.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Erro" },
                "example": { "mensagem": "Muitas requisições. Tente novamente em alguns minutos." }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Segundos até nova tentativa.",
                "schema": { "type": "integer" }
              }
            }
          },
          "500": {
            "description": "Falha ao consultar o banco.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Erro" },
                "example": { "mensagem": "Erro ao listar produtos" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Token JWT obtido em POST /login. Válido por 8 horas. Clique em **Authorize** (🔓), cole o token no campo e confirme. Não é necessário digitar 'Bearer' — o Swagger UI adiciona automaticamente."
      }
    },
    "schemas": {
      "PassaporteComponente": {
        "type": "object",
        "description": "Registro manual ou modelo do catálogo. Com componente_id, o backend usa nomes canônicos. Quantidade acima de 1 apenas para kits de memória.",
        "anyOf": [
          {
            "required": [
              "componente_id"
            ],
            "properties": {
              "componente_id": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          {
            "required": [
              "tipo",
              "modelo"
            ],
            "properties": {
              "modelo": {
                "type": "string",
                "minLength": 2,
                "maxLength": 120
              }
            }
          }
        ],
        "properties": {
          "tipo": {
            "type": "string",
            "minLength": 2,
            "maxLength": 50
          },
          "modelo": {
            "type": "string",
            "minLength": 2,
            "maxLength": 201
          },
          "componente_id": {
            "type": "integer",
            "minimum": 1,
            "nullable": true
          },
          "revisao": {
            "type": "integer",
            "minimum": 1,
            "readOnly": true
          },
          "quantidade": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4,
            "default": 1
          }
        }
      },
      "PassaporteEquipamento": {
        "type": "object",
        "required": [
          "nome",
          "tipo",
          "modelo",
          "componentes"
        ],
        "properties": {
          "nome": {
            "type": "string",
            "minLength": 3,
            "maxLength": 100
          },
          "tipo": {
            "type": "string",
            "enum": [
              "Computador",
              "Notebook",
              "Celular",
              "Tablet",
              "Periférico",
              "Outro"
            ]
          },
          "modelo": {
            "type": "string",
            "maxLength": 120
          },
          "componentes": {
            "type": "array",
            "maxItems": 20,
            "items": { "$ref": "#/components/schemas/PassaporteComponente" }
          }
        }
      },
      "PassaporteResumo": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "nome": {
            "type": "string",
            "minLength": 3,
            "maxLength": 100
          },
          "tipo": {
            "type": "string",
            "enum": [
              "Computador",
              "Notebook",
              "Celular",
              "Tablet",
              "Periférico",
              "Outro"
            ]
          },
          "modelo": {
            "type": "string",
            "maxLength": 120
          },
          "componentes": {
            "type": "array",
            "maxItems": 20,
            "items": { "$ref": "#/components/schemas/PassaporteComponente" }
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PassaportePublico": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "nome": {
            "type": "string",
            "minLength": 3,
            "maxLength": 100
          },
          "tipo": {
            "type": "string",
            "enum": [
              "Computador",
              "Notebook",
              "Celular",
              "Tablet",
              "Periférico",
              "Outro"
            ]
          },
          "modelo": {
            "type": "string",
            "maxLength": 120
          },
          "componentes": {
            "type": "array",
            "maxItems": 20,
            "items": { "$ref": "#/components/schemas/PassaporteComponente" }
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "registros": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 1
                },
                "tipo": {
                  "type": "string"
                },
                "titulo": {
                  "type": "string"
                },
                "ocorrido_em": {
                  "type": "string",
                  "format": "date-time"
                },
                "origem": {
                  "type": "string",
                  "enum": [
                    "manual",
                    "ehtech",
                    "plataforma"
                  ]
                },
                "garantia_fim_em": {
                  "type": "string",
                  "format": "date-time",
                  "nullable": true
                }
              }
            }
          }
        }
      },
      "PassaporteDetalhe": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "nome": {
            "type": "string",
            "minLength": 3,
            "maxLength": 100
          },
          "tipo": {
            "type": "string",
            "enum": [
              "Computador",
              "Notebook",
              "Celular",
              "Tablet",
              "Periférico",
              "Outro"
            ]
          },
          "modelo": {
            "type": "string",
            "maxLength": 120
          },
          "componentes": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "required": [
                "tipo",
                "modelo"
              ],
              "properties": {
                "tipo": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 50
                },
                "modelo": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 120
                }
              }
            }
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "registros": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 1
                },
                "tipo": {
                  "type": "string"
                },
                "titulo": {
                  "type": "string"
                },
                "ocorrido_em": {
                  "type": "string",
                  "format": "date-time"
                },
                "origem": {
                  "type": "string",
                  "enum": [
                    "manual",
                    "ehtech",
                    "plataforma"
                  ]
                },
                "garantia_fim_em": {
                  "type": "string",
                  "format": "date-time",
                  "nullable": true
                }
              }
            }
          },
          "publico_codigo": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "nullable": true
          },
          "transferencia_expira_em": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "CredenciaisLogin": {
        "type": "object",
        "required": ["email", "senha"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "description": "E-mail cadastrado (@gmail.com, @hotmail.com ou @outlook.com)."
          },
          "senha": {
            "type": "string",
            "minLength": 8,
            "description": "Senha do usuário (mínimo 8 caracteres)."
          }
        }
      },
      "RespostaLogin": {
        "type": "object",
        "properties": {
          "mensagem": { "type": "string" },
          "token": {
            "type": "string",
            "description": "Token JWT Bearer. Copie e use no botão Authorize (🔓)."
          },
          "username": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "userId": { "type": "integer" },
          "foto": { "type": "string", "nullable": true }
        }
      },
      "NovoProduto": {
        "type": "object",
        "required": ["nome", "descricao", "preco", "categoria"],
        "properties": {
          "exige_entrega": { "type": "boolean", "default": true },
          "origem_endereco_id": { "type": "integer", "minimum": 1, "description": "Endereço salvo da conta; obrigatório quando exige_entrega=true ou omitido." },
          "origem_versao": { "type": "integer", "minimum": 1, "description": "Versão confirmada do endereço selecionado." },
          "componente_id": { "type": "integer", "minimum": 1, "nullable": true, "description": "Modelo técnico ativo e verificado do catálogo; associação opcional e informada pelo vendedor." },
          "nome": {
            "type": "string",
            "maxLength": 255,
            "description": "Nome do produto. Obrigatório, não pode ser vazio."
          },
          "descricao": {
            "type": "string",
            "maxLength": 5000,
            "description": "Descrição detalhada do produto. Obrigatória."
          },
          "preco": {
            "type": "number",
            "minimum": 0.01,
            "description": "Preço em reais. Deve ser numérico e positivo."
          },
          "estoque": {
            "type": "integer",
            "minimum": 0,
            "default": 0,
            "description": "Quantidade em estoque. Valores negativos ou ausentes são tratados como 0."
          },
          "categoria": {
            "type": "string",
            "maxLength": 60,
            "description": "Categoria do produto. Obrigatória.",
            "example": "perifericos"
          },
          "imagem": {
            "oneOf": [
              {
                "type": "string",
                "description": "URL única da imagem (/uploads/... ou https://...)."
              },
              {
                "type": "array",
                "items": { "type": "string" },
                "description": "Lista de URLs de imagens."
              }
            ],
            "nullable": true,
            "description": "URL ou lista de URLs de imagem. Aceita /uploads/, https:// e data:image/. Null ou ausente é permitido."
          }
        }
      },
      "Produto": {
        "type": "object",
        "required": ["id_produto", "nome", "descricao", "preco", "estoque", "categoria", "imagem"],
        "properties": {
          "origem_uf": { "type": "string", "nullable": true },
          "origem_cidade": { "type": "string", "nullable": true },
          "data_criacao": { "type": "string", "format": "date-time", "nullable": true },
          "exige_entrega": { "oneOf": [{ "type": "boolean" }, { "type": "integer", "enum": [0, 1] }] },
          "componente_id": { "type": "integer", "minimum": 1, "nullable": true },
          "id_produto": { "type": "integer", "minimum": 1 },
          "nome": { "type": "string" },
          "descricao": { "type": "string", "nullable": true },
          "preco": {
            "description": "DECIMAL normalmente retorna texto; alguns adaptadores retornam número.",
            "oneOf": [
              { "type": "string", "example": "2499.90" },
              { "type": "number", "example": 2499.9 }
            ]
          },
          "estoque": { "type": "integer" },
          "categoria": { "type": "string" },
          "imagem": {
            "type": "string",
            "nullable": true,
            "description": "URL, string JSON com URLs ou data URI legada; não é lista normalizada."
          }
        }
      },
      "ProdutoCompleto": {
        "allOf": [
          { "$ref": "#/components/schemas/Produto" },
          {
            "type": "object",
            "properties": {
              "vendedor": { "type": "string" },
              "vendedor_id": { "type": "integer" },
              "status_aprovacao": {
                "type": "string",
                "enum": ["aprovado"]
              },
              "data_criacao": { "type": "string", "format": "date-time", "nullable": true }
            }
          }
        ]
      },
      "Catalogo": {
        "type": "object",
        "required": ["items", "total", "page", "limit", "totalPages"],
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Produto" }
          },
          "total": { "type": "integer", "minimum": 0 },
          "page": { "type": "integer", "minimum": 1 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 24 },
          "totalPages": { "type": "integer", "minimum": 1 }
        }
      },
      "Erro": {
        "type": "object",
        "required": ["mensagem"],
        "properties": {
          "mensagem": { "type": "string" }
        }
      }
    }
  }
}
