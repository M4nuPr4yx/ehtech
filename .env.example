# Opcional: copie para .env.local somente ao mudar o destino da API.
# Nunca coloque segredos em variáveis NEXT_PUBLIC_*.
BACKEND_URL=http://127.0.0.1:3000
# URL pública canônica para compartilhamento e sitemaps (configure na hospedagem).
SITE_URL=http://localhost:3001
# Deixe vazio para usar o proxy /api no mesmo domínio.
NEXT_PUBLIC_API_URL=
