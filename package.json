{
  "name": "ehtech",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <25",
    "npm": ">=10"
  },
  "scripts": {
    "setup": "node scripts/setup.cjs",
    "db:up": "docker compose up -d --wait db",
    "db:stop": "docker compose stop db",
    "db:init": "node scripts/init-database.cjs",
    "admin:promote": "node scripts/promote-admin.cjs",
    "dev": "concurrently --kill-others -n \"FRONT,BACK\" -c \"cyan,magenta\" \"next dev -p 3001\" \"node backend/index.js\"",
    "dev:front": "next dev -p 3001",
    "dev:back": "node backend/index.js",
    "build": "next build",
    "start": "next start -p 3001",
    "start:all": "concurrently --kill-others -n \"FRONT,BACK\" -c \"cyan,magenta\" \"next start -p 3001\" \"node backend/index.js\"",
    "lint": "eslint",
    "check": "npm run lint && npm test && npm run build",
    "seed:test-data": "node scripts/seed-test-data.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:integration": "node tests/run-integration.cjs",
    "test:integration:postgres": "node tests/run-integration.cjs --postgres",
    "test:integration:postgres:local": "node tests/run-postgres-local.cjs",
    "test:e2e": "node tests/run-e2e.cjs"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.2",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "mysql2": "^3.11.0",
    "next": "16.1.7",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "swagger-ui-dist": "5.32.15",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "^9.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.1.7",
    "tailwindcss": "^4"
  }
}
