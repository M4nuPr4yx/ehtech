# npm run setup cria backend/.env com chave aleatória sem sobrescrever arquivos.
# Estes valores correspondem ao compose.yaml (desenvolvimento local).
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=ehtech
DB_PASSWORD=ehtech_local
DB_DATABASE=ehtech
DB_SSL=false
API_SEGREDO=
PORT=3000
FRONTEND_URL=http://localhost:3001
# PostgreSQL/Neon: configure DATABASE_URL e retire as opções DB_* de MySQL.
# DATABASE_URL=postgresql://usuario:senha@host/ehtech
# Sem SMTP, a recuperação de senha não envia e-mails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# IA opcional. Use backend/.env.ai para configurar sem alterar credenciais existentes.
# disabled | gemini (externo) | ollama (local) | groq (externo).
# Em produção, configure as variáveis no painel da hospedagem.
COMPAT_AI_PROVIDER=disabled
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
COMPAT_AI_TIMEOUT_MS=30000
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=

# Produção na Vercel: adicionado automaticamente ao conectar um Blob público.
# BLOB_READ_WRITE_TOKEN=

# Modalidades reais definidas pela operação/vendedor. Sem configuração, entrega física fica indisponível.
# Consulte docs/ENDERECOS_CHECKOUT.md. Não há cobrança ou consulta de transportadora automática.
SHIPPING_RULES_JSON=[]
